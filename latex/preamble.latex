% TikZ styles for test setup diagrams
\tikzstyle{block} = [rectangle, draw, fill=blue!20, text centered, rounded corners, minimum height=3em]
\tikzstyle{network} = [rectangle, draw, fill=blue!20, text centered, rounded corners, minimum height=3em, font=\faNetworkWired]
\tikzstyle{icon} = [align=center, font=\Huge, text centered, minimum width=0cm, minimum height=0cm]
\tikzstyle{data} = [trapezium, trapezium left angle=70, trapezium right angle=110, draw, fill=orange!20, text centered, minimum height=3em, minimum width=3cm, text width=2.5cm]
\tikzstyle{arrow_data_twoway} = [thick,<->,>=latex, draw=blue, dashed]
\tikzstyle{arrow_data_oneway} = [thick,->,>=latex, draw=blue, dashed]
\tikzstyle{arrow_power} = [thick,->,>=latex, draw=red]
\tikzstyle{arrow_beam} = [thick,->,>=o, draw=black, dashed]
