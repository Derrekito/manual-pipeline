\documentclass[11pt]{article}
${ preamble() }
${ codeblocks() }
${ fonts() }
${ styles() }

$if(bibfile)$
\addbibresource{$bibfile$}
$endif$

\newcommand{\passthrough}[1]{#1}

% Set default scaling for images to not exceed max width or height while keeping aspect ratio
\setkeys{Gin}{width=\linewidth,height=\textheight,keepaspectratio}

% Set figure caption font size
\captionsetup[figure]{font=footnotesize}

$if(title)$
\title{$title$}
$endif$
$if(author)$
\author{$for(author)$$author$$sep$ \and $endfor$}
$endif$

$if(date)$
\date{$date$}
$endif$

% Settings a caller passes with --include-in-header (-H) or header-includes,
% last so they can change anything above: page size, headers, image limits.
$for(header-includes)$
$header-includes$
$endfor$

\begin{document}

$if(title)$
${titlepage()}
$endif$

\pagenumbering{roman}
$if(toc)$
\tableofcontents
\newpage
$endif$
\clearpage
$if(acronyms)$
\section*{List of Acronyms and Abbreviations}
$if(toc)$
\addcontentsline{toc}{section}{List of Acronyms and Abbreviations}
$endif$
\input{./latex/acronyms.tex}
\newpage
$endif$
\pagenumbering{arabic}
\setcounter{page}{1}

$if(abstract)$
\begin{abstract}
$abstract$
\end{abstract}
$endif$

$body$

$if(bibfile)$
\printbibliography
$endif$
\end{document}
