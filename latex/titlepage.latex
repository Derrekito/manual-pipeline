% Title page layout
\begin{titlepage}
  \centering
  \vspace*{2cm}
  {\Huge\bfseries $title$}\par
  $if(subtitle)$
    \vspace{1.5cm}
    {\Large $subtitle$}\par
  $endif$
  $if(author)$
    \vspace{2cm}
    {\Large $author$$if(email)$\\ {\small\href{$email$}{$email$}} $endif$}\par
  $endif$
  \vfill
  $if(version)$
    {\large Version $version$}\par
    \vspace{0.5cm}
  $endif$
  $if(date)$
    {\large $date$}\par
  $endif$
  $if(disclaimer)$
    \vspace{2cm}
    {\small $disclaimer$}
  $endif$
  $if(logo-block)$
$logo-block$
  $endif$
  $if(distro)$
    $if(unmlogo)$$else$
      \vfill
    $endif$
    {$distro$}\par
  $endif$
  $if(rev)$
    \vspace{1cm}
    \begin{center}
      \textbf{Rev. $rev$}
    \end{center}
  $endif$
\end{titlepage}
