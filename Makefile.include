# manual-pipeline/Makefile.include
# Include this file from your project's manual/Makefile
#
# Required variables (set before including):
#   PROJECT_NAME    - Name of the project (e.g., "radcast", "sparcl")
#   MANUAL_DIR      - Path to the project's manual directory
#   PIPELINE_DIR    - Path to the manual-pipeline directory
#
# Optional variables:
#   MASTER_DOC      - Path to main markdown file (default: $(MANUAL_DIR)/$(PROJECT_NAME)-manual.md)
#   EXTRA_DEPS      - Additional dependencies for PDF/DOCX targets

# Validate required variables
ifndef PROJECT_NAME
$(error PROJECT_NAME is not set. Set it before including Makefile.include)
endif
ifndef MANUAL_DIR
$(error MANUAL_DIR is not set. Set it before including Makefile.include)
endif
ifndef PIPELINE_DIR
$(error PIPELINE_DIR is not set. Set it before including Makefile.include)
endif

# Derived paths
MASTER_DOC ?= $(MANUAL_DIR)/$(PROJECT_NAME)-manual.md
BUILD_DIR := $(MANUAL_DIR)/build
OUTPUT_DIR := $(MANUAL_DIR)/output
VENV_DIR := $(MANUAL_DIR)/venv
SCRIPTS_DIR := $(PIPELINE_DIR)/scripts

# Output files
PDF_OUTPUT := $(OUTPUT_DIR)/$(PROJECT_NAME)-manual.pdf
DOCX_OUTPUT := $(OUTPUT_DIR)/$(PROJECT_NAME)-manual.docx

# Marker file for setup completion
SETUP_MARKER := $(VENV_DIR)/.setup_complete

# Source file patterns
DOC_FILES := $(wildcard $(MANUAL_DIR)/docs/*.md)
LATEX_FILES := $(wildcard $(MANUAL_DIR)/latex/*.tex) $(wildcard $(PIPELINE_DIR)/latex/*.latex)
FILTER_FILES := $(wildcard $(PIPELINE_DIR)/latex/filters/*.lua) $(wildcard $(PIPELINE_DIR)/latex/filters/*.py)
PANDOC_FILES := $(wildcard $(PIPELINE_DIR)/defaults/*.yaml) $(SCRIPTS_DIR)/create_pdf.sh

# Export for scripts
export MANUAL_DIR
export PIPELINE_DIR

# Colours, messages and boxed help menus
include $(PIPELINE_DIR)/mk/colors.mk
include $(PIPELINE_DIR)/mk/messages.mk
include $(PIPELINE_DIR)/mk/help_menu.mk

.PHONY: all help pdf docx setup check-deps clean distclean

all: pdf

help:
	$(call mp_help_header,$(PROJECT_NAME) Manual - manual-pipeline)
	$(call mp_help_section,Build)
	$(call mp_help_command,make pdf,Generate the PDF manual)
	$(call mp_help_command,make docx,Generate the DOCX manual)
	$(call mp_help_section,Setup)
	$(call mp_help_command,make setup,Install dependencies (runs on first build))
	$(call mp_help_command,make check-deps,Verify system dependencies)
	$(call mp_help_section,Cleanup)
	$(call mp_help_command,make clean,Remove build artifacts)
	$(call mp_help_command,make distclean,Remove all generated files and the venv)
	$(call mp_help_footer,Output: $(patsubst $(CURDIR)/%,%,$(OUTPUT_DIR))/)

# Setup marker - created after check-deps succeeds
$(SETUP_MARKER):
	$(call mp_info,Running first-time setup...)
	@$(SCRIPTS_DIR)/check_deps.sh
	@mkdir -p $(VENV_DIR)
	@touch $(SETUP_MARKER)

setup: $(SETUP_MARKER)
	$(call mp_success,Setup complete)

check-deps:
	@$(SCRIPTS_DIR)/check_deps.sh
	@touch $(SETUP_MARKER)
	$(call mp_success,Dependencies OK)

# PDF depends on setup marker - auto-runs setup if needed
$(PDF_OUTPUT): $(SETUP_MARKER) $(MASTER_DOC) $(DOC_FILES) $(LATEX_FILES) $(FILTER_FILES) $(PANDOC_FILES) $(EXTRA_DEPS)
	$(call mp_info,Building $(notdir $(PDF_OUTPUT))...)
	@$(SCRIPTS_DIR)/create_pdf.sh $(MASTER_DOC) 1 pdf
	$(call mp_success,Manual generated: $(PDF_OUTPUT))

pdf: $(PDF_OUTPUT)

# DOCX depends on setup marker - auto-runs setup if needed
$(DOCX_OUTPUT): $(SETUP_MARKER) $(MASTER_DOC) $(DOC_FILES) $(LATEX_FILES) $(FILTER_FILES) $(PANDOC_FILES) $(EXTRA_DEPS)
	$(call mp_info,Building $(notdir $(DOCX_OUTPUT))...)
	@$(SCRIPTS_DIR)/create_pdf.sh $(MASTER_DOC) 1 docx
	$(call mp_success,Manual generated: $(DOCX_OUTPUT))

docx: $(DOCX_OUTPUT)

clean:
	$(call mp_info,Cleaning build artifacts...)
	@rm -rf $(BUILD_DIR)
	$(call mp_success,Clean complete)

distclean: clean
	$(call mp_warning,Removing all generated files and the venv...)
	@rm -rf $(OUTPUT_DIR)
	@rm -rf $(VENV_DIR)
	@rm -f $(SETUP_MARKER)
	$(call mp_success,Distclean complete)
