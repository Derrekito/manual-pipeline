% Formatting styles: sections, spacing, headers/footers
\usepackage{titling}

% Title page spacing
\renewcommand\maketitlehooka{\vspace{180pt}}
\renewcommand\maketitlehookd{\vfill}

% Section heading style: bold, large, numbered, underlined
\titleformat{\section}
  {\normalfont\Large\bfseries}{\thesection}{1em}{}[\titlerule]

% Set TOC hierarchy level
\setcounter{tocdepth}{2}
\renewcommand{\contentsname}{Table of Contents}

% Spacing options
$if(tight)$
\setlength{\parskip}{0pt}
\setlist{%
  topsep=6pt,
  partopsep=0pt,
  itemsep=6pt,
}

\titlespacing*{\section}
{0pt}
{6pt}
{6pt}

\titlespacing*{\subsection}
{0pt}
{5pt}
{5pt}

$else$
\setlength{\parskip}{6pt plus 2pt minus 1pt}
$endif$

% Tight list fallback
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}}

% Image scaling defaults
\setkeys{Gin}{width=\linewidth,height=\textheight,keepaspectratio}

% Figure caption size
\captionsetup[figure]{font=footnotesize}

% Header/footer setup
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrulewidth}{0pt}

$if(distro)$
\rfoot{\scriptsize $distro$}
$else$
\renewcommand{\footrulewidth}{0pt}
$endif$
\fancyfoot[C]{\break\thepage}

% Section numbering toggle
$if(secnum)$
$else$
\setcounter{secnumdepth}{0}
$endif$

% PDF metadata
\hypersetup{%
  pdftitle={$if(title)$ $title${ }$endif$ $if(author)$by $author$ $endif$}
}
